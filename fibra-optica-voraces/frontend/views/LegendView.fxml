<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<VBox spacing="8.0" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-border-color: #aaaaaa; -fx-border-radius: 5; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.controllers.LegendController">
    <children>
        <Label text="LEYENDA DE RED" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
        
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Circle fill="DODGERBLUE" radius="6.0" />
                <Label text="Central" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Circle fill="GREEN" radius="6.0" />
                <Label text="Poste Secundario" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Circle fill="RED" radius="6.0" />
                <Label text="Cliente / Abonado" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Circle fill="YELLOW" radius="6.0" />
                <Label text="Poste Sugerido" />
            </children>
        </HBox>
        
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Circle fill="ORANGE" radius="6.0" />
                <Label text="Poste Saturado" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Circle fill="GREY" radius="6.0" />
                <Label text="Nodo Inactivo" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
</VBox>